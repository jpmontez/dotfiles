# Secrets & credentials
ssh/.ssh/id_*
ssh/.ssh/known_hosts
ssh/.ssh/agent/

# Generic credential patterns (defense-in-depth)
*.pem
*.key
*.p12
*.pfx
.env
.env.*
!.env.example
*credentials*
*secret*
.netrc

# Shell history
.histfile
.zsh_history
.bash_history

# Local tool settings (runtime state only — claude/ stow package is tracked)
/.claude/

# Nested git repos (managed as submodules instead)
zprezto/.git

# OS artifacts
.DS_Store
*.swp
*~

# Brew bundle lockfile (regenerated on each `brew bundle`)
Brewfile.lock.json

# Per-machine tier record written by bootstrap.sh (PERSONAL=yes|no)
.machine
